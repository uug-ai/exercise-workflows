GOWORK=off
LOG_LEVEL=info
LOG_OUTPUT=text

RABBITMQ_SCHEME=amqps
RABBITMQ_HOST=broker.example.com:5671
# Keep credentials single-quoted so shell loading preserves dollars and spaces.
RABBITMQ_USERNAME=''
RABBITMQ_PASSWORD=''
RABBITMQ_VHOST='/'
# Set this to the <username>-forward-queue configured in the forwarder block.
STAGE_QUEUE=''

STAGE_OPERATION=forwarder
# Optional override in Unix seconds; empty uses the Agent filename in media.key.
# Use an override only for one recording whose key lacks the timestamp prefix.
MARKER_START_TIMESTAMP=
MARKER_DURATION_SECONDS=30
YOLO_MODEL=/opt/yolo/yolo11n.onnx
ONNXRUNTIME_SHARED_LIBRARY=/opt/onnxruntime/lib/libonnxruntime.so.1.29.0
YOLO_CONFIDENCE=0.5
YOLO_SAMPLE_FPS=1
RESULT_MODE=http

# Raw Hub access token with workflow-runs.update scope (without the Bearer prefix)
WORKFLOW_BEARER_TOKEN=''

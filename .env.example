GOWORK=off
LOG_LEVEL=info
LOG_OUTPUT=text

RABBITMQ_SCHEME=amqps
RABBITMQ_HOST=broker.example.com:5671
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
STAGE_QUEUE=

STAGE_OPERATION=forwarder
MARKER_START_TIMESTAMP=1700000000
MARKER_DURATION_SECONDS=30
YOLO_MODEL=/opt/yolo/yolo11n.onnx
ONNXRUNTIME_SHARED_LIBRARY=/opt/onnxruntime/lib/libonnxruntime.so.1.29.0
YOLO_CONFIDENCE=0.5
YOLO_SAMPLE_FPS=1
RESULT_MODE=preview

# Hub access token with workflow-run.update scope
WORKFLOW_BEARER_TOKEN=

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tests: internal app",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/internal/app",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Stage: offline sample",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["-input", "examples/workflow-invocation.json"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Stage: queue preview",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "RESULT_MODE": "preview"
      }
    },
    {
      "name": "Stage: queue bypass",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "RESULT_MODE": "bypass"
      }
    },
    {
      "name": "Stage: HTTP callback (API pending)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "RESULT_MODE": "http"
      }
    }
  ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Stage: offline sample",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["-input", "examples/workflow-run.json"],
      "env": {
        "GOWORK": "off",
        "STAGE_OPERATION": "loitering",
        "MARKER_START_TIMESTAMP": "1700000000",
        "MARKER_DURATION_SECONDS": "30",
        "RESULT_MODE": "preview"
      }
    },
    {
      "name": "Stage: queue preview",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "env": {
        "GOWORK": "off",
        "RABBITMQ_SCHEME": "amqps",
        "RABBITMQ_HOST": "${input:brokerHost}",
        "RABBITMQ_USERNAME": "${input:brokerUsername}",
        "RABBITMQ_PASSWORD": "${input:brokerPassword}",
        "RABBITMQ_VHOST": "/",
        "STAGE_QUEUE": "${input:stageQueue}",
        "STAGE_OPERATION": "loitering",
        "MARKER_START_TIMESTAMP": "${input:markerStart}",
        "MARKER_DURATION_SECONDS": "30",
        "RESULT_MODE": "preview"
      }
    },
    {
      "name": "Stage: HTTP callback (API pending)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["-once"],
      "env": {
        "GOWORK": "off",
        "RABBITMQ_SCHEME": "amqps",
        "RABBITMQ_HOST": "${input:brokerHost}",
        "RABBITMQ_USERNAME": "${input:brokerUsername}",
        "RABBITMQ_PASSWORD": "${input:brokerPassword}",
        "RABBITMQ_VHOST": "/",
        "STAGE_QUEUE": "${input:stageQueue}",
        "STAGE_OPERATION": "loitering",
        "MARKER_START_TIMESTAMP": "${input:markerStart}",
        "MARKER_DURATION_SECONDS": "30",
        "RESULT_MODE": "http",
        "WORKFLOW_RESULT_URL": "${input:callbackURL}",
        "WORKFLOW_BEARER_TOKEN": "${input:bearerToken}"
      }
    }
  ],
  "inputs": [
    {
      "id": "brokerHost",
      "type": "promptString",
      "description": "Test RabbitMQ hostname:port (TLS usually uses 5671)"
    },
    {
      "id": "brokerUsername",
      "type": "promptString",
      "description": "RabbitMQ username"
    },
    {
      "id": "brokerPassword",
      "type": "promptString",
      "description": "RabbitMQ password",
      "password": true
    },
    {
      "id": "stageQueue",
      "type": "promptString",
      "description": "Exact queue assigned by the facilitator"
    },
    {
      "id": "markerStart",
      "type": "promptString",
      "description": "Test recording start timestamp in Unix seconds"
    },
    {
      "id": "callbackURL",
      "type": "promptString",
      "description": "Confirmed Hub result API URL ending in /workflows/{runId}"
    },
    {
      "id": "bearerToken",
      "type": "promptString",
      "description": "Workflow-scoped API bearer token",
      "password": true
    }
  ]
}